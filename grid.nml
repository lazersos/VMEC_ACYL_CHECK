&grid
  nr = 128
  nphi = 241
  nz = 128
  ! R/Z bounds default to sampled WOUT boundary extrema, in meters.
  ! Uncomment to restrict the comparison to a smaller rectangular box:
  ! rmin = 5.0, rmax = 6.0, zmin = -0.5, zmax = 0.5
  phi0 = 0.0
  full_torus = .false.
  s_min = 0.0001
  s_max = 1.0
  output = 'comparison.csv'
/
